# Local development can omit every value below and use SQLite.
# Production fails closed if its required values are missing.
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
# Use the limited rallylog_web role and require encrypted transport.
# DATABASE_URL=postgresql://rallylog_web:password@host/database?sslmode=require
# PUBLIC_HOST=rallylog.example.com
REGISTRATION_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=true
# RESEND_API_KEY=re_...
# MAIL_FROM=Tennisd <account@your-verified-domain.example>
# ADMIN_EMAIL=owner@example.com
# CONTACT_EMAIL=privacy@example.com
# Keep advertising disabled until AdSense approves the site and its consent message is published.
ADSENSE_CLIENT_ID=ca-pub-9135813423535698
ADSENSE_ENABLED=false
# Public IndexNow site-verification key. Keep it stable after search engines discover it.
INDEXNOW_KEY=a4f23d7e946b4aa8b36740f15f67e2c1
# Free current/upcoming ATP and WTA data from https://livetennisapi.com/
# LIVETENNISAPI_KEY=lt_...
# Free historical ATP/WTA results from Tennis API on RapidAPI (50 requests/day).
# RAPIDAPI_TENNIS_KEY=...
# TENNIS_API_DAILY_REQUESTS=48
# Free current odds from https://the-odds-api.com/ (server-side only).
# THE_ODDS_API_KEY=...
